# Copy this file to backend/.env and fill in the values. Never commit backend/.env.

# Secret used to sign login tokens (JWT). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# OpenAI key for the chatbot. Optional: without it the chatbot falls back to scripted questions.
OPENAI_API_KEY=

# First admin account, created on startup only if no admin exists yet.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
